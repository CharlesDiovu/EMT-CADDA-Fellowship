#Task 5
# Identify NR and SR assay columns

nr_cols = ["NR-AR","NR-AR-LBD","NR-AhR","NR-Aromatase","NR-ER","NR-ER-LBD","NR-PPAR-gamma"]

sr_cols = ["SR-ARE","SR-ATAD5","SR-HSE","SR-MMP","SR-p53"]

# Step 1: Calculate summary scores
data["NR_score"] = data[nr_cols].mean(axis=1)   # average NR activation

data["SR_score"] = data[sr_cols].mean(axis=1)   # average SR activation (toxicity risk)

# Step 2: Apply filtering criteria

# - High NR activity: NR_score > 0.5
# - Low SR activity: SR_score < 0.3

selected = data[(data["NR_score"] > 0.5) & (data["SR_score"] < 0.3)]

print("Number of promising candidates:", selected.shape[0])
print("Preview of selected drugs:")
print(selected[["mol_id","NR_score","SR_score"]].head())

#Task 6 and 7
# Step 3: Visualization

plt.figure(figsize=(8,6))
sns.scatterplot(data=data, x="NR_score", y="SR_score", alpha=0.4, label="All Compounds")
sns.scatterplot(data=selected, x="NR_score", y="SR_score", color="red", s=100, label="Selected Candidates")
plt.axhline(0.3, color="blue", linestyle="--", label="Low Toxicity Threshold")
plt.axvline(0.5, color="green", linestyle="--", label="High NR Activity Threshold")
plt.xlabel("Average Nuclear Receptor (NR) Activity")
plt.ylabel("Average Stress Response (SR) Activity")
plt.title("Drug Candidate Selection: High NR Activity & Low SR Activity")
plt.legend()
plt.show()